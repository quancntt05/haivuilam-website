{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": "../",
    "outDir": "../dist",
    "baseUrl": "../src",
    "paths": {
      "@/*": ["../src/*"],
      "@config/*": ["../src/config/*"],
      "@controllers/*": ["../src/controllers/*"],
      "@middleware/*": ["../src/middleware/*"],
      "@services/*": ["../src/services/*"],
      "@utils/*": ["../src/utils/*"],
      "@types/*": ["../src/types/*"]
    }
  },
  "include": ["**/*", "../src/**/*"],
  "exclude": []
}

